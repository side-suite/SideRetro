# Copy this file to `keystore.properties` (gitignored) and replace every placeholder.
# A release build without this file deliberately uses the Android debug key for local
# qualification only. Never publish a debug-key-signed APK: it is insecure and cannot
# be updated by an APK signed with your real release key.
#
# Create the release key once, store it securely, and retain it for every future update:
#   keytool -genkeypair -v -keystore sideretro-release.jks -alias sideretro \
#       -keyalg RSA -keysize 4096 -validity 10000
#
# storeFile is relative to this `app/` Gradle project directory (or may be absolute).

storeFile=sideretro-release.jks
storePassword=CHANGE_ME
keyAlias=sideretro
keyPassword=CHANGE_ME
