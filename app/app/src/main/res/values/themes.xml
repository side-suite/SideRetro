<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Black, no action bar. The game surface floats in black by decision (SPEC.md §4.2/§4.4): the OS
      already rounds the real case at the correct 12px radius for free, and software-rounding the
      picture's own corners imitates a physical feature that isn't there.

      Fullscreen is NOT left to this theme — GameActivity states it in code, because §4.1 makes it
      load-bearing rather than cosmetic.
    -->
    <style name="Theme.SideRetro" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
